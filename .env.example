# NullKey Environment Variables

# Server Configuration
PORT=2020
NODE_ENV=development

# Allowed WebSocket origins (comma-separated). Requests without a matching
# origin header are rejected. If unset, defaults to http://localhost:3000 —
# production deployments MUST set this to the origin browsers use,
# e.g. ALLOWED_ORIGINS=https://chat.example.com
ALLOWED_ORIGINS=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_MAX_CONNECTIONS_PER_IP=20

# Message Rate Limiting (per fingerprint)
RATE_LIMIT_MESSAGES_PER_WINDOW=60
RATE_LIMIT_MESSAGES_WINDOW_MS=60000

# Room Configuration
MAX_ROOM_LIFETIME_MINUTES=60
MAX_PARTICIPANTS_PER_ROOM=10
ROOM_IDLE_TIMEOUT_MINUTES=10

# Message Configuration
# MAX_MESSAGE_SIZE_BYTES bounds non-file messages.
# File messages are bounded by MAX_FILE_SIZE_BYTES; the WebSocket frame
# budget is sized automatically to carry base64(file + GCM tag) for a file
# of that size (~1.33x), so both sides can keep the same 100 MB limit.
MESSAGE_TTL_MINUTES=5
MAX_MESSAGE_SIZE_BYTES=1048576
MAX_FILE_SIZE_BYTES=104857600

# Replay Protection
REPLAY_PROTECTION_ENABLED=true

# Security Headers
SECURITY_HEADERS_ENABLED=true

# Abusive Client Disconnect
DISCONNECT_ON_REPEATED_VIOLATIONS=true
MAX_VIOLATIONS_BEFORE_DISCONNECT=10

# Cleanup
CLEANUP_INTERVAL_MS=60000